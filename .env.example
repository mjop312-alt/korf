# Kopieer naar .env en vul in.
# Postgres-connectiestring (bv. Neon: neon.tech → project → Connection string).
# Lokaal zonder externe dienst? Zet dit op "file:./dev.db" en `provider` in
# prisma/schema.prisma terug op "sqlite" — het schema is bewust portabel geschreven.
DATABASE_URL="postgresql://user:wachtwoord@host/db?sslmode=require"
AUTH_SECRET="genereer-met: npx auth secret"
AUTH_URL="http://localhost:3000"
DATA_MODE="mock"

# Voor sitemap.xml/robots.txt én de links in e-mails — zet in productie op de echte domeinnaam.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E-mail (prijsalert-meldingen + wekelijkse besparingssamenvatting), via Resend.
# Leeg laten = geen echte mail, de scripts loggen alleen wat ze zouden sturen (dry-run).
# Aanzetten: gratis account op resend.com → API-key aanmaken → domein verifiëren
# (of gebruik "Korf <onboarding@resend.dev>" voor een test naar je eigen adres).
RESEND_API_KEY=""
EMAIL_FROM="Korf <onboarding@resend.dev>"

# Sentry (error-monitoring). Leeg laten = uitgeschakeld, geen account nodig voor lokale dev.
# Maak een gratis project op sentry.io en vul de DSN in om crashes daar te zien.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Alleen nodig als je source maps wil uploaden bij een productie-build:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
